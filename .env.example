# PostgreSQL (Supabase pooler port 6543, ou Neon.tech pooler)
DATABASE_URL=postgresql://postgres.vzvetkyoukfawlikynzj:1IPbNdO1EVQCB8CG@aws-0-eu-north-1.pooler.supabase.com:6543/postgres

# Groq API
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Email (3 sources)
SENDER_EMAIL_1=test1@domain.com
SENDER_EMAIL_2=test2@domain.com
SENDER_EMAIL_3=test3@domain.com
SENDER_PASSWORD_1=password1
SENDER_PASSWORD_2=password2
SENDER_PASSWORD_3=password3

# IMAP Inboxes (mêmes boîtes que les 3 adresses émettrices)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ICP Criteria
ICP_LOCATIONS=Paris,Lyon,Marseille
ICP_MIN_PROPERTIES=50
ICP_RESULTS_PER_LOCATION=5

# Sourcing conforme des agences via Google Places API (recommandé).
# Active "Places API" sur console.cloud.google.com et facturation associée
# (quota gratuit mensuel). Si absent, fallback automatique sur SEED_AGENCIES_JSON.
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Fallback manuel si GOOGLE_PLACES_API_KEY n'est pas configuré (JSON) :
# [{"name": "...", "public_email": "...", "catalog_url": "...", "location": "Paris"}]
SEED_AGENCIES_JSON=[]
